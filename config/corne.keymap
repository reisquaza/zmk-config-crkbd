#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        enter {
            bindings = <&kp ENTER>;
            key-positions = <19 20>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <2 1>;
        };

        ctrl+shift {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <25 26>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 15>;
        };

        ctrl+backspace {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <28 27>;
        };

        symbol_layer {
            bindings = <&to 3>;
            key-positions = <32 33>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&trans  &kp Q  &kp W  &kp E             &kp R  &kp T        &kp Y           &kp U  &kp I         &kp O    &kp P     &trans
&trans  &kp A  &kp S  &kp D             &kp F  &kp G        &kp H           &kp J  &kp K         &kp L    &kp SEMI  &kp APOS
&trans  &kp Z  &kp X  &kp C             &kp V  &kp B        &kp N           &kp M  &kp COMMA     &kp DOT  &kp FSLH  &trans
                      &kp LEFT_CONTROL  &mo 1  &kp SPACE    &kp LEFT_SHIFT  &to 2  &kp LEFT_ALT
            >;
        };

        nump_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp F9  &kp F10  &kp F11           &kp F12  &trans       &kp STAR        &kp N7  &kp N8        &kp N9  &kp SLASH  &trans
&trans  &kp F4  &kp F3   &kp F2            &kp F1   &trans       &kp PLUS        &kp N1  &kp N2        &kp N3  &kp MINUS  &trans
&trans  &kp F8  &kp F7   &kp F6            &kp F5   &trans       &kp PERCENT     &kp N4  &kp N5        &kp N6  &kp N0     &trans
                         &kp LEFT_CONTROL  &trans   &kp SPACE    &kp LEFT_SHIFT  &trans  &kp LEFT_ALT
            >;
        };

        navigation_layer {
            bindings = <
&trans  &trans  &trans          &trans            &trans        &trans             &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW    &kp UP_ARROW  &kp RIGHT_ARROW    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans          &trans            &trans        &trans             &trans          &trans          &trans        &trans           &trans  &trans
                                &kp LEFT_CONTROL  &to 1         &kp SPACE          &kp LSHFT       &to 0           &kp LEFT_ALT
            >;
        };

        symbol_layer {
            bindings = <
&trans  &kp UNDER        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS  &kp PIPE         &kp CARET       &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR  &trans             &trans
&trans  &kp EXCLAMATION  &kp STAR       &kp SLASH         &kp EQUAL  &kp AMPERSAND    &kp HASH        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMI    &kp DOUBLE_QUOTES  &to 0
&trans  &kp TILDE        &kp PLUS       &kp LBKT          &kp RBKT   &kp PERCENT      &kp AT_SIGN     &kp COLON             &kp COMMA              &kp DOT     &kp APOS           &trans
                                        &kp LEFT_CONTROL  &to 1      &kp SPACE        &kp LEFT_SHIFT  &to 2                 &kp LEFT_ALT
            >;
        };
    };
};
